    { "source": "/student-handbook", "destination": "/student-guide" },
    { "source": "/coach", "destination": "/coach-handbook" },
    { "source": "/coach-playbook", "destination": "/coach-handbook" },
    { "source": "/coaching", "destination": "/coach-handbook" },
    { "source": "/integration", "destination": "/integrations" },
    { "source": "/api", "destination": "/developer-api" },
    { "source": "/export", "destination": "/integrations" },
    { "source": "/exports", "destination": "/integrations" },
    { "source": "/webhooks", "destination": "/integrations" },
    { "source": "/backup", "destination": "/integrations" }
  ],
  "seo": {
    "metatags": {
      "og:site_name": "Kaynos Docs",
      "og:type": "website"
    },
    "indexing": "navigable"
  },
  "footer": {
    "socials": {}
  }
}
