{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kaynos Docs",
  "description": "Kaynos help center - setup, video upload, playback, troubleshooting, and developer API reference.",
  "colors": {
    "primary": "#2184F3",
    "light": "#4DA3F7",
    "dark": "#1A6FDB"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "dark": "#060609",
      "light": "#FFFFFF"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "logo": {
    "light": "/logo/kaynos-light.svg",
    "dark": "/logo/kaynos-dark.svg",
    "href": "https://docs.kaynos.net"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Help center",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "setup", "roles", "glossary", "faq"]
          },
          {
            "group": "Video",
            "pages": ["uploading", "playback", "formats", "storage", "recording-setup"]
          },
          {
            "group": "Sessions & Classes",
            "pages": ["creating-sessions", "creating-classes", "notes", "progress"]
          },
          {
            "group": "Account",
            "pages": ["profile", "billing"]
          },
          {
            "group": "Admin",
            "pages": ["inviting-members", "managing-members", "developer-api", "integrations"]
          },
          {
            "group": "Role guides",
            "pages": ["coach-handbook", "student-guide", "parent-guide"]
          },
          {
            "group": "Troubleshoot",
            "pages": ["troubleshoot", "login-issues", "email-issues", "performance", "errors", "using-on-mobile"]
          },
          {
            "group": "More",
            "pages": ["release-notes", "feature-requests", "contact", "privacy-on-this-site", "data-rights"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Marketing site",
        "href": "https://www.kaynos.net"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.kaynos.net"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    { "source": "/whats-new", "destination": "/release-notes" },
    { "source": "/quick-tips", "destination": "/setup" },
    { "source": "/onboarding-timeline", "destination": "/setup" },
    { "source": "/first-upload", "destination": "/uploading" },
    { "source": "/upload-checklist", "destination": "/uploading" },
    { "source": "/speed-calculator", "destination": "/formats" },
    { "source": "/player-shortcuts", "destination": "/playback" },
    { "source": "/session-vs-class", "destination": "/creating-sessions" },
    { "source": "/tags", "destination": "/notes" },
    { "source": "/notifications", "destination": "/profile" },
    { "source": "/upload-issues", "destination": "/uploading" },
    { "source": "/playback-issues", "destination": "/playback" },
    { "source": "/error-lookup", "destination": "/errors" },
    { "source": "/browser-check", "destination": "/troubleshoot" },
    { "source": "/mobile", "destination": "/performance" },
    { "source": "/pricing", "destination": "/billing" },
    { "source": "/subscription", "destination": "/billing" },
    { "source": "/cancel", "destination": "/billing" },
    { "source": "/refund", "destination": "/billing" },
    { "source": "/invoice", "destination": "/billing" },
    { "source": "/invoices", "destination": "/billing" },
    { "source": "/error", "destination": "/errors" },
    { "source": "/error-codes", "destination": "/errors" },
    { "source": "/troubleshooting-errors", "destination": "/errors" },
    { "source": "/camera", "destination": "/recording-setup" },
    { "source": "/cameras", "destination": "/recording-setup" },
    { "source": "/recording", "destination": "/recording-setup" },
    { "source": "/hardware", "destination": "/recording-setup" },
    { "source": "/equipment", "destination": "/recording-setup" },
    { "source": "/tripod", "destination": "/recording-setup" },
    { "source": "/microphone", "destination": "/recording-setup" },
    { "source": "/privacy-rights", "destination": "/data-rights" },
    { "source": "/gdpr", "destination": "/data-rights" },
    { "source": "/ccpa", "destination": "/data-rights" },
    { "source": "/dpa", "destination": "/data-rights" },
    { "source": "/student", "destination": "/student-guide" },
