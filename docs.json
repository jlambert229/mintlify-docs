{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kaynos Docs",
  "description": "Kaynos help center - setup, video upload, playback, troubleshooting, and developer API reference.",
  "colors": {
    "primary": "#2184F3",
    "light": "#5BA8F7",
    "dark": "#1769C2"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "dark": "#0E1016",
      "light": "#FFFFFF"
    }
  },
  "logo": {
    "light": "/logo/kaynos-light.svg",
    "dark": "/logo/kaynos-dark.svg",
    "href": "https://docs.kaynos.net"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Help center",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Marketing site",
        "href": "https://www.kaynos.net"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.kaynos.net"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "seo": {
    "metatags": {
      "og:site_name": "Kaynos Docs",
      "og:type": "website"
    },
    "indexing": "navigable"
  },
  "footer": {
    "socials": {}
  }
}
